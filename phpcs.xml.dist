<?xml version="1.0"?>
<ruleset name="Hide Admin Bar Based on User Roles">
	<description>WordPress coding standards and PHP 5.6+ compatibility for Hide Admin Bar Based on User Roles.</description>

	<!-- What to check. -->
	<file>.</file>
	<exclude-pattern>/.git/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- The bundled Freemius SDK follows its own standards. -->
	<exclude-pattern>/includes/freemius/*</exclude-pattern>
	<!-- Scripts that build the wordpress.org listing assets; not part of the plugin. -->
	<exclude-pattern>/tools/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Match the plugin header: WordPress 5.5+ and PHP 5.6+. -->
	<config name="minimum_wp_version" value="5.5"/>
	<config name="testVersion" value="5.6-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hide-admin-bar-based-on-user-roles"/>
			</property>
		</properties>
	</rule>

	<!--
	Class, function, hook, option and file names date from the plugin's first
	release and use its short "hab" prefix. Other code relies on them, so they
	are kept as they are instead of being renamed to satisfy these checks.
	-->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="PEAR.NamingConventions.ValidClassName"/>
	</rule>
</ruleset>
